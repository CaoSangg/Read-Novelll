# ==============================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN KHẤU VẤN TIÊN ĐẠO (MẪU)
# ==============================================================================

# 1. Kết nối Supabase (Giữ nguyên cho Next.js Production hiện tại)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Cấu hình GitHub Actions CI/CD (Vercel Legacy)
VERCEL_TOKEN=your_vercel_personal_access_token_here
VERCEL_ORG_ID=your_vercel_team_or_user_org_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# 3. Cấu hình Python FastAPI Backend & PostgreSQL Pool (Phase 1.5)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/readnovel_dev
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-at-least-32-chars
ENVIRONMENT=development
SESSION_EXPIRE_DAYS=7
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG_DB_QUERY=false
