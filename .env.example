# Vercel Deployment Secrets (Cau hinh tren GitHub Repository -> Settings -> Secrets and variables -> Actions)
VERCEL_TOKEN=your_vercel_personal_access_token_here
VERCEL_ORG_ID=your_vercel_team_or_user_org_id_here
VERCEL_PROJECT_ID=your_vercel_project_id_here

# Môi trường ứng dụng (App Environment)
NODE_ENV=development
